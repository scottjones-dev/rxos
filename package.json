{
  "name": "rxos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "concurrent:launch": "pnpm --filter @rxos/vehicle-simulator... build && pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/dual-display-launcher.js",
    "concurrent:test": "pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/concurrent-reliability.js",
    "demo": "pnpm --filter @rxos/vehicle-simulator demo",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "localisation:validate": "pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/localisation-validate.js",
    "native:format": "cargo fmt --all",
    "native:format:check": "cargo fmt --all -- --check",
    "native:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "native:test": "cargo test --workspace --all-features",
    "native:verify": "pnpm native:format:check && pnpm native:lint && pnpm native:test",
    "performance:observe": "pnpm --filter @rxos/vehicle-simulator performance:observe",
    "performance:native:short": "pnpm --filter @rxos/vehicle-simulator... build && pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/linux-performance.js 8",
    "performance:native:extended": "pnpm --filter @rxos/vehicle-simulator... build && pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/linux-performance.js 600 build/performance/native-extended.json",
    "qt:build": "cmake --build build/native --parallel",
    "qt:configure": "cmake -S . -B build/native -G Ninja -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON",
    "qt:lint": "cmake --build build/native --target all_qmllint",
    "qt:test": "ctest --test-dir build/native --output-on-failure",
    "layout:test": "pnpm qt:test --tests-regex qml-telemetry-state",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "visual:baseline": "pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/visual-capture.js tests/visual/baselines",
    "visual:capture": "pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/visual-capture.js build/visual/current",
    "visual:compare": "pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/visual-compare.js",
    "visual:gallery": "pnpm --filter @rxos/validation-tools... build && node apps/validation-tools/dist/src/visual-gallery.js",
    "visual:verify": "pnpm visual:capture && pnpm visual:compare && pnpm visual:gallery",
    "verify": "pnpm verify:node && pnpm native:verify && pnpm qt:configure && pnpm qt:lint && pnpm qt:build && pnpm qt:test",
    "verify:milestone-1.3": "pnpm verify && pnpm localisation:validate && pnpm concurrent:test && pnpm visual:verify && pnpm performance:native:short",
    "verify:node": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
