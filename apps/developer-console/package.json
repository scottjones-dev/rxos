{
  "name": "@rxos/developer-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rxos/ipc": "workspace:*",
    "@rxos/vehicle-schema": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.0.6"
  }
}
